// ============================================
// TANAVIA - Prisma Schema
// Database: PostgreSQL (Neon)
// ============================================

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ============================================
// USER (Customer + Staff + Admin)
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  name            String
  passwordHash    String
  role            Role      @default(CUSTOMER)
  emailVerified   DateTime?
  phoneVerified   DateTime?
  twoFactorOn     Boolean   @default(false)
  twoFactorSecret String?
  lastLoginAt     DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  wishlist        Wishlist[]
  notifications   Notification[]
  shifts          Shift[]
  reports         StaffReport[]   @relation("ReportedBy")
  resolvedReports StaffReport[]   @relation("ResolvedBy")
  auditLogs       AuditLog[]
  cashDrawers     CashDrawer[]

  // Customer module relations
  customerProfile  Customer?       @relation("UserCustomerProfile")
  authoredNotes    CustomerNote[]
  blockedCustomers Customer[]      @relation("CustomerBlockedBy")

  @@index([email])
  @@index([phone])
  @@index([role])
}

// ============================================
// CUSTOMER (shop + website)
// ============================================

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique  // normalized: 01XXXXXXXXX
  email         String?
  userId        String?   @unique  // link to User account (optional)

  blockedAt     DateTime?
  blockedReason String?   @db.Text
  blockedById   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User?     @relation("UserCustomerProfile", fields: [userId], references: [id])
  blockedBy     User?     @relation("CustomerBlockedBy", fields: [blockedById], references: [id])

  orders        Order[]
  notes         CustomerNote[]
  tags          CustomerTag[]

  @@index([phone])
  @@index([userId])
  @@index([createdAt])
  @@index([blockedAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  text       String   @db.Text
  pinned     Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])

  @@index([customerId])
  @@index([authorId])
  @@index([pinned])
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  tag        String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tag])
  @@index([customerId])
  @@index([tag])
}

// ============================================
// SESSION (JWT refresh tokens)
// ============================================

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

// ============================================
// ADDRESS (Customer delivery addresses)
// ============================================

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?  @default("Home")
  fullName  String
  phone     String
  address   String   @db.Text
  district  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// SHIFT (Staff working hours)
// ============================================

model Shift {
  id          String      @id @default(cuid())
  userId      String
  status      ShiftStatus @default(OPEN)
  openingCash Decimal     @default(0) @db.Decimal(10, 2)
  closingCash Decimal?    @db.Decimal(10, 2)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  note        String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, status])
  @@index([openedAt])
}

// ============================================
// CATEGORY
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  nameBn      String?
  slug        String   @unique
  description String?  @db.Text
  image       String?
  position    Int      @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([slug])
  @@index([position])
  @@index([featured, active])
  @@index([active])
}

// ============================================
// PRODUCT (with variants)
// ============================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  nameBn        String?
  description   String        @db.Text
  descriptionBn String?       @db.Text
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  categoryLegacy String?      @map("category")  // old string field — keep for migration
  brand         String        @default("TANAVIA")
  sku           String        @unique
  barcode       String        @unique
  cost          Decimal       @db.Decimal(10, 2)
  price         Decimal       @db.Decimal(10, 2)
  discount      Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  active        Boolean       @default(true)
  featured      Boolean       @default(false)
  tryable       Boolean       @default(true)
  shape         String        @default("tee")
  images        String[]
  tags          String[]
  rating        Float         @default(0)
  reviewCount   Int           @default(0)
  soldCount     Int           @default(0)

  metaTitle       String?
  metaDescription String?       @db.Text
  deletedAt       DateTime?
  deletedById     String?
  deletedReason   String?       @db.Text
  lowStockAt      Int           @default(5)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  productImages ProductImage[]
  variants      Variant[]
  orderItems    OrderItem[]
  stockMoves    StockMovement[]
  reviews       Review[]
  wishlist      Wishlist[]
  dropProducts  DropProduct[]
  purchaseItems PurchaseOrderItem[]

  @@index([categoryId, active])
  @@index([featured, active])
  @@index([barcode])
  @@index([sku])
  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

// ============================================
// PRODUCT IMAGE (ordered, with alt + primary)
// ============================================

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, position])
}

model Variant {
  id           String    @id @default(cuid())
  productId    String
  sku          String?   @unique
  barcode      String?   @unique
  size         String
  color        String
  qty          Int       @default(0)
  reserved     Int       @default(0)
  reorderLevel Int       @default(5)
  cost         Decimal?  @db.Decimal(10, 2)  // moving average cost
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMoves      StockMovement[]
  purchaseItems   PurchaseOrderItem[]
  staffReports    StaffReport[]         @relation("VariantReports")

  @@unique([productId, size, color])
  @@index([productId])
  @@index([qty])
  @@index([barcode])
}

// ============================================
// DROP (New stuff / collection launch)
// ============================================

enum DropStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
}

model Drop {
  id          String     @id @default(cuid())
  name        String
  nameBn      String?
  slug        String     @unique
  description String?    @db.Text
  bannerUrl   String?
  status      DropStatus @default(DRAFT)
  releaseAt   DateTime
  endAt       DateTime?
  isFeatured  Boolean    @default(false)
  countdownOn Boolean    @default(true)
  notifyOn    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products DropProduct[]

  @@index([status, releaseAt])
  @@index([slug])
}

model DropProduct {
  id        String   @id @default(cuid())
  dropId    String
  productId String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  drop    Drop    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dropId, productId])
  @@index([dropId])
  @@index([productId])
}

// ============================================
// ORDER (online + offline)
// ============================================

enum OrderChannel {
  ONLINE
  OFFLINE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  CARD
  CASH
}

enum PaymentStatus {
  UNPAID
  PENDING
  WAITING
  REVIEW
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique
  channel       OrderChannel @default(ONLINE)
  userId        String?
  customerId    String?
  shiftId       String?
  createdById   String?
  status        OrderStatus  @default(PLACED)

  customerName  String
  customerPhone String
  customerEmail String?
  address       String?      @db.Text
  district      String?
  note          String?      @db.Text

  subtotal      Decimal      @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal      @default(0) @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  couponCode    String?

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentTxId   String?
  senderPhone   String?
  verifiedAt    DateTime?
  codSettledAt  DateTime?

  cancelReason  String?      @db.Text
  adminNote     String?      @db.Text

  courier       String?
  consignmentId String?
  courierStatus String?
  trackingUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  items        OrderItem[]
  events       OrderEvent[]
  transactions Transaction[]
  returns      Return[]

  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@index([customerPhone])
  @@index([orderNumber])
  @@index([userId])
  @@index([customerId])
  @@index([shiftId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  size      String
  color     String
  qty       Int
  price     Decimal @db.Decimal(10, 2)
  cost      Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  returns ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

// ============================================
// RETURN (customer returns & refunds)
// ============================================

enum ReturnStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  REFUNDED
  COMPLETED
  REJECTED
}

enum ReturnReason {
  SIZE_WRONG
  COLOR_WRONG
  DAMAGED
  DEFECTIVE
  NOT_AS_DESCRIBED
  CHANGED_MIND
  LATE_DELIVERY
  WRONG_ITEM
  OTHER
}

enum RefundMethod {
  CASH_BACK
  BKASH_REFUND
  NAGAD_REFUND
  BANK_TRANSFER
  STORE_CREDIT
  EXCHANGE
  NO_REFUND
}

enum ItemCondition {
  PENDING
  OK
  DAMAGED
  DEFECTIVE
}

model Return {
  id             String       @id @default(cuid())
  returnNumber   String       @unique
  orderId        String
  channel        OrderChannel

  createdById    String
  approvedById   String?
  rejectedById   String?
  inspectedById  String?
  refundedById   String?
  shiftId        String?

  status         ReturnStatus @default(REQUESTED)
  reason         ReturnReason
  reasonNote     String?      @db.Text

  refundAmount   Decimal      @default(0) @db.Decimal(10, 2)
  refundMethod   RefundMethod?
  refundTxId     String?
  refundedAt     DateTime?

  // Online return logistics
  courier        String?
  consignmentId  String?
  trackingUrl    String?

  // Inspection
  inspectedAt    DateTime?
  inspectionNote String?      @db.Text

  // Rejection
  rejectionNote  String?      @db.Text

  notes          String?      @db.Text
  adminNote      String?      @db.Text

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order          Order        @relation(fields: [orderId], references: [id])
  items          ReturnItem[]
  events         ReturnEvent[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([returnNumber])
  @@index([createdById])
}

model ReturnItem {
  id           String         @id @default(cuid())
  returnId     String
  orderItemId  String
  productId    String
  variantId    String?
  name         String
  size         String
  color        String
  qty          Int
  unitPrice    Decimal        @db.Decimal(10, 2)
  unitCost     Decimal        @db.Decimal(10, 2)

  condition    ItemCondition  @default(PENDING)
  restocked    Boolean        @default(false)
  restockedAt  DateTime?

  return       Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem    OrderItem      @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([orderItemId])
}

model ReturnEvent {
  id         String   @id @default(cuid())
  returnId   String
  status     String
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  actor     String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============================================
// STOCK MOVEMENT (full audit log)
// ============================================

enum StockMoveType {
  PURCHASE
  SALE_ONLINE
  SALE_OFFLINE
  RETURN
  RETURN_DAMAGE
  DAMAGE
  ADJUSTMENT
  TRANSFER
  RESERVE
  RESERVE_RELEASE
}

model StockMovement {
  id        String        @id @default(cuid())
  productId String
  variantId String?
  type      StockMoveType
  qty       Int
  before    Int
  after     Int
  reason    String?
  refId     String?
  actorId   String?
  createdAt DateTime      @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id])

  @@index([productId, createdAt])
  @@index([variantId])
  @@index([type, createdAt])
}

// ============================================
// TRANSACTION (COD waiting / cash received)
// ============================================

enum TransactionType {
  ONLINE_PAYMENT
  OFFLINE_CASH
  COD_RECEIVED
  REFUND
  COURIER_CHARGE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id          String            @id @default(cuid())
  orderId     String?
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(10, 2)
  method      String?
  reference   String?
  note        String?           @db.Text
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@index([type, status])
  @@index([orderId])
  @@index([createdAt])
}

// ============================================
// EXPENSE (shop costs)
// ============================================

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  PACKAGING
  MARKETING
  TRANSPORT
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String          @db.Text
  receiptUrl  String?
  spentAt     DateTime        @default(now())
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, spentAt])
  @@index([spentAt])
}

// ============================================
// CASH DRAWER (daily open/close count)
// ============================================

enum CashDrawerStatus {
  OPEN
  CLOSED
}

model CashDrawer {
  id            String           @id @default(cuid())
  userId        String
  shiftId       String?
  status        CashDrawerStatus @default(OPEN)
  openingAmount Decimal          @db.Decimal(10, 2)
  closingAmount Decimal?         @db.Decimal(10, 2)
  expectedCash  Decimal?         @db.Decimal(10, 2)
  difference    Decimal?         @db.Decimal(10, 2)
  note          String?          @db.Text
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([openedAt])
}

// ============================================
// COUPON
// ============================================

enum CouponType {
  PERCENT
  FIXED
  SHIPPING
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minSpend    Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscount Decimal?   @db.Decimal(10, 2)
  usageLimit  Int?
  usedCount   Int        @default(0)
  perUser     Int        @default(1)
  active      Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([code, active])
  @@index([expiresAt])
}

// ============================================
// SUPPLIER + PURCHASE ORDER
// ============================================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?  @db.Text
  note      String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases PurchaseOrder[]

  @@index([name])
  @@index([phone])
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String          @id @default(cuid())
  poNumber   String          @unique
  supplierId String
  status     PurchaseStatus  @default(DRAFT)
  subtotal   Decimal         @db.Decimal(10, 2)
  paid       Decimal         @default(0) @db.Decimal(10, 2)
  due        Decimal         @db.Decimal(10, 2)
  note       String?         @db.Text
  orderedAt  DateTime        @default(now())
  receivedAt DateTime?
  createdBy  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id         String        @id @default(cuid())
  purchaseId String
  productId  String
  variantId  String?
  qty        Int
  unitCost   Decimal       @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  received   Int           @default(0)
  createdAt  DateTime      @default(now())

  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  variant  Variant?      @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([variantId])
}

// ============================================
// REVIEW
// ============================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String        @id @default(cuid())
  productId  String
  userId     String?
  name       String
  rating     Int
  comment    String?       @db.Text
  images     String[]
  approved   Boolean       @default(false)  // legacy — keep for migration
  status     ReviewStatus  @default(PENDING)
  reply      String?       @db.Text
  repliedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, status])
  @@index([productId, approved])
  @@index([userId])
  @@index([rating])
  @@index([status, createdAt])
}

// ============================================
// WISHLIST
// ============================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================
// NOTIFICATION
// ============================================

enum NotificationType {
  ORDER
  STOCK
  COURIER
  PAYMENT
  SYSTEM
  DROP
  STAFF_REPORT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([type, createdAt])
}

// ============================================
// STAFF REPORT (issue reporting)
// ============================================

enum ReportType {
  WRONG_PRODUCT
  DAMAGE
  MISSING
  PRICE_ERROR
  CUSTOMER_ISSUE
  LOW_STOCK
  DAMAGED_ITEM
  COUNT_MISMATCH
  WRONG_BARCODE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model StaffReport {
  id          String       @id @default(cuid())
  reportedBy  String
  resolvedBy  String?
  type        ReportType
  status      ReportStatus @default(OPEN)
  title       String
  description String       @db.Text
  productId   String?
  variantId   String?
  orderId     String?
  proofUrl    String?
  adminNote   String?      @db.Text
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime     @updatedAt

  reporter User     @relation("ReportedBy", fields: [reportedBy], references: [id])
  resolver User?    @relation("ResolvedBy", fields: [resolvedBy], references: [id])
  variant  Variant? @relation("VariantReports", fields: [variantId], references: [id])

  @@index([reportedBy])
  @@index([variantId])
  @@index([status, createdAt])
  @@index([type])
}

// ============================================
// AUDIT LOG (every admin/staff action)
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actor     String
  action    String
  detail    String?  @db.Text
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ============================================
// SETTINGS (key-value store)
// ============================================

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}