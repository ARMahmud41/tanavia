{
  "": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", ".env"],
  "globalEnv": [
    "NODE_ENV","DATABASE_URL","REDIS_URL","JWT_SECRET","JWT_REFRESH_SECRET",
    "COOKIE_SECRET","API_URL","WEB_URL","R2_ACCOUNT_ID","R2_ACCESS_KEY",
    "R2_SECRET_KEY","R2_BUCKET","R2_PUBLIC_URL","STEADFAST_API_KEY",
    "STEADFAST_SECRET_KEY","SSLCOMMERZ_STORE_ID","SSLCOMMERZ_STORE_PASSWORD",
    "SMS_API_KEY","RESEND_API_KEY","SENTRY_DSN"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}